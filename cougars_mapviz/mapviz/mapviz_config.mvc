capture_directory: $HOME
fixed_frame: map
target_frame: origin
fix_orientation: false
rotate_90: false
enable_antialiasing: true
show_displays: true
show_status_bar: true
show_capture_tools: true
window_width: 1680
window_height: 1013
view_scale: 0.19226788
offset_x: -13.4907761
offset_y: -6.1386857
use_latest_transforms: true
background: "#ffffff"
image_transport: raw
displays:
  - type: mapviz_plugins/tile_map
    name: Map
    config:
      visible: true
      collapsed: true
      custom_sources:
        - base_url: http://localhost:8080/wmts/gm_layer/gm_grid/{level}/{x}/{y}.png
          max_zoom: 19
          name: Google Maps
          type: wmts
      bing_api_key: ""
      stadia_api_key: ""
      source: Google Maps
  - type: cougars_mapviz/cougars_waypoints
    name: Waypoints
    config:
      visible: true
      collapsed: false
  - type: cougars_mapviz/cougars_startup
    name: System Control
    config:
      visible: true
      collapsed: false
  - type: mapviz_plugins/odometry
    name: Global Odom
    config:
      visible: true
      collapsed: true
      topic: /coug0/odometry/global
      color: "#00ff00"
      draw_style: points
      position_tolerance: 0
      buffer_size: 0
      show_laps: false
      show_covariance: true
      show_all_covariances: false
      static_arrow_sizes: false
      arrow_size: 25
      show_timestamps: 0
      qos_depth: 10
      qos_history: 1
      qos_reliability: 1
      qos_durability: 2
  - type: mapviz_plugins/navsat
    name: Raw GPS
    config:
      visible: true
      collapsed: true
      topic: /coug0/fix
      color: "#aa0000"
      draw_style: points
      position_tolerance: 0
      buffer_size: 5000
      qos_depth: 10
      qos_history: 1
      qos_reliability: 1
      qos_durability: 2
  - type: mapviz_plugins/odometry
    name: DVL Odom
    config:
      visible: false
      collapsed: true
      topic: /coug0/dvl/odom
      color: "#ff00ff"
      draw_style: points
      position_tolerance: 0
      buffer_size: 0
      show_laps: false
      show_covariance: false
      show_all_covariances: false
      static_arrow_sizes: false
      arrow_size: 25
      show_timestamps: 0
      qos_depth: 10
      qos_history: 1
      qos_reliability: 1
      qos_durability: 2
  - type: mapviz_plugins/odometry
    name: Sim GT
    config:
      visible: true
      collapsed: true
      topic: /holoocean/coug0/DynamicsSensorGT
      color: "#000000"
      draw_style: points
      position_tolerance: 0
      buffer_size: 0
      show_laps: false
      show_covariance: false
      show_all_covariances: false
      static_arrow_sizes: false
      arrow_size: 25
      show_timestamps: 0
      qos_depth: 10
      qos_history: 1
      qos_reliability: 1
      qos_durability: 2
  - type: cougars_mapviz/cougars_origin
    name: Origin
    config:
      visible: false
      collapsed: true