<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>base_station_bringup</name>
  <version>0.0.0</version>
  <description>Launch bringup package for the base station stack.</description>
  <maintainer email="frostlab@todo.todo">frostlab</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>base_station_coms</exec_depend>
  <exec_depend>base_station_gui</exec_depend>
  <exec_depend>cougars_mapviz</exec_depend>
  <exec_depend>seatrac</exec_depend>
  <exec_depend>gpsd_client</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
